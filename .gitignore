# ============================================================================
# PUBLIC / PRIVATE BOUNDARY
# The public repository contains pipeline code and reproducible methodology.
# Personal podcast inputs, transcripts, notes, audio, generated pages, and logs
# stay local and must never be committed.
# ============================================================================

# Secrets
.env
api_keys*
*.key
*.pem

# Private podcast workspace: transcripts, notes, reviews, audio and metadata
/content/

# Generated website is private/local. Only deployment configuration is public.
/site/**
!/site/deploy.sh
!/site/wrangler.toml

# Local run output and ad-hoc reports
/reports/
/.runlogs/

# Source and generated media
*.mp3
*.m4a
*.aac
*.flac
*.wav
*原始音频*

# Python environments and caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv-alignment/
venv/

# Local Cloudflare / agent / editor state
.wrangler/
.claude/
.codex/
.agents/
.vscode/
.idea/
.mcp.json
skills-lock.json
test.txt

# Personal shell and system configuration
.bash_profile
.bashrc
.zshrc
.zprofile
.profile
.ripgreprc
.gitconfig
.gitmodules
.DS_Store
Thumbs.db
*.tmp

# Public benchmark contracts/references stay tracked; downloaded media and
# generated runs do not.
benchmarks/**/audio/
benchmarks/**/source/
benchmarks/**/results/
