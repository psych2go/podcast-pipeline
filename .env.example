# ===== 播客处理流水线 · 环境变量 =====
# 复制此文件为 .env 并填入你的 API key
# cp .env.example .env

# Fish Audio TTS（生成音频时必填）
FISH_KEY=your-fish-audio-api-key-here
FISH_VOICE=b561236e80b04f22843c6637682b5478
# FISH_MODEL=mm3                           # 可选，默认 s2.1-pro-free（免费版）

# HuggingFace Token (可选，说话人分离用)
HF_TOKEN=hf_your-huggingface-token-here
#   说话人分离（--diarize）必需。申请：huggingface.co/settings/tokens
#   需在 huggingface.co 接受 pyannote/speaker-diarization-3.1
#   与 pyannote/segmentation-3.0 的用户协议。
#   仅用 ASR 转录（不分离）则无需配置。

# 内容存储目录 (可选，默认 content/)
# PODCAST_DIR=/path/to/custom/content

# ────────────────────────────────────────────────────────────
# 以下为 legacy：讲稿生成已改由 Claude Code 直接完成，不再需要。
# 仅当你要用 scripts/generator.py(legacy) 走 DeepSeek API 自动生成时才配置。
# ────────────────────────────────────────────────────────────
# DEEPSEEK_KEY=sk-your-key-here
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# DS_MODEL=deepseek-v4-flash

# Cloudflare R2 + Pages
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
R2_BUCKET=podcast-audio
PAGES_PROJECT=podcast-scripts
PAGES_BASE_URL=https://podcast-scripts.pages.dev

# ASR（可选；命令行参数优先）
# ASR_MODEL=large-v3
# ASR_MODEL_CACHE=/path/to/whisper-models
# ASR_DEVICE=cpu
# ASR_COMPUTE_TYPE=int8
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Claim 级证据迁移（可选；新内容应在生成 content_map 时直接填写 evidence v3）
# CLAIM_EVIDENCE_MODEL=sonnet
# CLAIM_EVIDENCE_EFFORT=high
# CLAIM_EVIDENCE_BATCH_CHARS=35000
# CLAIM_EVIDENCE_CONCURRENCY=3
