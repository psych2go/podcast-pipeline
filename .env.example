# ===== 播客处理流水线 · 环境变量 =====
# 复制此文件为 .env 并填入你的 API key
# cp .env.example .env

# Fish Audio TTS（生成音频时必填）
FISH_KEY=your-fish-audio-api-key-here
FISH_VOICE=your-fish-audio-voice-id
# FISH_MODEL=mm3                           # 可选，默认 s2.1-pro-free（免费版）

# 外部请求重试（可选）
API_MAX_RETRIES=3
API_RETRY_BACKOFF=2.0
API_TIMEOUT=120
# FETCH_MAX_RETRIES=3
# FETCH_TIMEOUT=30
# TTS_MAX_RETRIES=3
# TTS_TIMEOUT=120

# HuggingFace Token (可选，说话人分离用)
HF_TOKEN=hf_your-huggingface-token-here
#   说话人分离（--diarize）必需。申请：huggingface.co/settings/tokens
#   需在 huggingface.co 接受 pyannote/speaker-diarization-3.1
#   与 pyannote/segmentation-3.0 的用户协议。
#   仅用 ASR 转录（不分离）则无需配置。

# 内容存储目录 (可选，默认 content/)
# PODCAST_DIR=/path/to/custom/content

# ────────────────────────────────────────────────────────────
# Subagent 编排（默认使用本机 codex exec）
# 可替换为兼容的 runner；禁止配置为 Claude CLI。
# ────────────────────────────────────────────────────────────
# SUBAGENT_COMMAND=codex
# 主 runner 连续失败后自动切换；建议指向不同 provider 或独立配置。
# SUBAGENT_FALLBACK_COMMAND=codex --ignore-user-config
# SUBAGENT_TIMEOUT=1800
# SUBAGENT_REVIEW_MODEL=
# SUBAGENT_CLAIM_MODEL=
# SUBAGENT_REVIEW_EFFORT=max
# SUBAGENT_CLAIM_EFFORT=high
# SUBAGENT_MAX_RETRIES=2

# 以下为 legacy：仅当你要走 scripts/legacy/generator.py 才配置。
# DEEPSEEK_KEY=sk-your-key-here
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# DS_MODEL=deepseek-v4-flash

# Cloudflare R2 + Pages
# Wrangler 默认使用 `wrangler login` 保存的 OAuth。
# 不要把 CLOUDFLARE_API_TOKEN 写入项目 .env；Wrangler 会自行加载该文件，
# 过期 token 会覆盖仍然有效的 OAuth。CI 应在外部环境注入 token。
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
R2_BUCKET=your-r2-bucket
PAGES_PROJECT=your-pages-project
PAGES_BASE_URL=https://your-pages-project.pages.dev

# ASR（可选；命令行参数优先）
# ASR_MODEL=large-v3-turbo
# ASR_MODEL_CACHE=/path/to/whisper-models
# ASR_DEVICE=auto             # auto / cpu / cuda
# ASR_COMPUTE_TYPE=auto       # auto: CUDA=int8_float16, CPU=int8
# ASR_REFINE_MAX_RANGES=8
# GPU 运行库：.venv/bin/pip install -r requirements-asr-gpu.txt
# ALIGNMENT_MODE=auto         # auto / whisperx / none
# ALIGNMENT_DEVICE=cpu
# ALIGNMENT_MODEL=
# ALIGNMENT_PYTHON=/path/to/.venv-alignment/bin/python
# ALIGNMENT_TIMEOUT=3600
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# DIARIZATION_DEVICE=auto
# DIARIZATION_EXCLUSIVE=true

# Claim 级证据迁移（可选；新内容由主脚本自动编排）
# CLAIM_EVIDENCE_BATCH_CHARS=35000
# CLAIM_EVIDENCE_CONCURRENCY=3
